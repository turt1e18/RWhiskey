# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/storybook-static/
/storybook.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env and local-only configuration
.env*
*.local
*.local.*
application-local.properties

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#dev
.env
.env.dev
.env.local

#dev markdown
worklog.md
*.md
*.erd
sample*.html
!README.md

# playwright (산출물·인증 상태·시험 계정 정보는 Git 제외)
/e2e/.output*/
/e2e/.report/
/e2e/.auth/
